{
  "name": "mikoshi-web",
  "version": "0.1.0",
  "private": true,
  "description": "Mikoshi 工作台前端骨架（SBS-0007）：演示登录、SaaS外壳、可定制首页与六业务入口",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "sync:legacy": "node scripts/sync-legacy.mjs",
    "predev": "node scripts/sync-legacy.mjs",
    "dev": "next dev --hostname 127.0.0.1 --port 3100",
    "prebuild": "node scripts/sync-legacy.mjs",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3100",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.59.0",
    "next": "16.4.2",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
